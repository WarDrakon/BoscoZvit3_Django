# Скопіюйте цей файл у .env і задайте власні значення. Файл .env не потрапляє в Git.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=змініть-на-довгий-випадковий-рядок
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example

# MySQL (DB_ENGINE=sqlite — лише для швидкої локальної перевірки без MySQL)
DB_ENGINE=mysql
DB_NAME=roommate
DB_USER=roommate
DB_PASSWORD=змініть-пароль
DB_HOST=127.0.0.1
DB_PORT=3306

# Пошта. У розробці листи друкуються в консоль.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Roommate <no-reply@example.com>
