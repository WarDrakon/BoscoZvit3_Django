# Скопіюйте цей файл у .env і задайте значення. Файл .env не потрапляє в Git.
# Коментарі — лише на окремих рядках (після значення вони стали б частиною значення).

# True для розробки, False для production
DJANGO_DEBUG=
# довгий випадковий рядок
DJANGO_SECRET_KEY=
# напр. localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=
# напр. https://your-domain.example
DJANGO_CSRF_TRUSTED_ORIGINS=

# MySQL 8: DB_ENGINE=mysql (sqlite — лише для швидких локальних перевірок)
DB_ENGINE=
DB_NAME=
DB_USER=
DB_PASSWORD=
# 127.0.0.1 (TCP) або localhost (сокет)
DB_HOST=
# зазвичай 3306
DB_PORT=

# Пошта (у розробці: django.core.mail.backends.console.EmailBackend)
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=
DEFAULT_FROM_EMAIL=
